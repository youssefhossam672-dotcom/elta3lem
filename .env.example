# Node.js 24+ and persistent local storage are required.
# Every variable in this file is SERVER-SIDE ONLY. Never prefix a database
# setting or secret with NEXT_PUBLIC_ (that would ship it to every browser).
# Copy to .env.local (development) or set them as machine/service
# environment variables (production). .env.local is git-ignored.

# --- Database ---------------------------------------------------------------
# sqlserver = Microsoft SQL Server (production). sqlite = local development,
# automated tests, and the SOURCE of the one-time data transfer.
# Production (NODE_ENV=production) refuses to start without this setting, and
# there is NO fallback from sqlserver to sqlite.
DATABASE_PROVIDER=sqlserver

# Instance: "host\INSTANCE" for a named instance (resolved by the SQL Server
# Browser service — no port assumed), or "host,port" for a fixed TCP port,
# or a hosted server name (e.g. myserver.database.windows.net).
SQLSERVER_SERVER=localhost\MSSQLSERVER03
SQLSERVER_DATABASE=Elta3lemDB
# windows = Windows integrated authentication: SQL Server sees the Windows
# account the Node.js process runs as. No user name or password is stored.
# sql = SQL authentication for hosted servers (then set SQLSERVER_USER /
# SQLSERVER_PASSWORD in the server environment or a secret store — never in
# source control).
SQLSERVER_AUTH_MODE=windows
# SQLSERVER_USER=
# SQLSERVER_PASSWORD=
# Installed ODBC driver (Windows authentication uses msnodesqlv8 over ODBC).
SQLSERVER_ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Encryption is ON and the server certificate is VALIDATED by default.
# A local development instance usually has a self-signed certificate: ONLY
# there you may set SQLSERVER_TRUST_SERVER_CERTIFICATE=true. Production must
# keep it false and install a trusted certificate on SQL Server.
SQLSERVER_ENCRYPT=true
SQLSERVER_TRUST_SERVER_CERTIFICATE=false
# Connection pool per Node.js process (total connections = processes × max).
SQLSERVER_POOL_MAX=20
SQLSERVER_POOL_MIN=0
SQLSERVER_POOL_IDLE_TIMEOUT_MS=30000
SQLSERVER_CONNECTION_TIMEOUT_MS=15000
SQLSERVER_REQUEST_TIMEOUT_MS=30000

# Admin workspace at scale: lists load the newest N rows (exact totals and
# server-side search cover everything else); totals are cached per process.
# ADMIN_LIST_WINDOW=1000
# ADMIN_TOTALS_CACHE_MS=60000
# Password hashing runs on Node's libuv thread pool (default 4 threads).
# UV_THREADPOOL_SIZE=8

# Cutover write freeze: "read-only" refuses every change (HTTP 503) while
# reads keep working. Used during the SQLite → SQL Server data transfer.
# ELTA3LEM_MAINTENANCE=read-only

# --- Files ------------------------------------------------------------------
# Optional; defaults to ./data (SQLite database + uploads when using sqlite)
# LMS_DATA_DIR=/absolute/persistent/path
# Uploaded files stay on disk (metadata in the database). With several app
# servers, point this at shared storage (SMB share / mounted volume).
# LMS_UPLOAD_DIR=D:\Elta3lem\uploads
# Production origin, including scheme, without a trailing slash.
# LMS_ORIGIN=https://your-lms.example
# Set a private, random invitation code if administrator signup is required.
# LMS_ADMIN_INVITE=replace-with-a-private-random-value

# --- SMS (required for "Forgot password") -----------------------------------
# Password-reset codes are sent by SMS. Until a provider is configured the
# reset page answers "temporarily unavailable" — no SMS is ever faked.
# Choose ONE provider: twilio | vonage
# SMS_PROVIDER=twilio
#
# Twilio (https://console.twilio.com) — use a Messaging Service (recommended,
# lets Twilio pick an Egypt-capable sender) OR a from number.
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx
#
# Vonage (https://dashboard.nexmo.com)
# VONAGE_API_KEY=your-api-key
# VONAGE_API_SECRET=your-api-secret
# VONAGE_FROM=Elta3lem
